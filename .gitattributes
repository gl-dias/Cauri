# Fim de linha LF em todo texto, mesmo clonando no Windows.
* text=auto eol=lf

*.py text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
justfile text eol=lf
Dockerfile text eol=lf

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.zip binary
*.xlsx binary
*.pdf binary
