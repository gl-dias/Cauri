# Variáveis de ambiente do Cauri. Copie para .env (que nunca vai para o git).
# Os valores abaixo apontam para o Supabase local (supabase start); são os valores
# públicos da CLI, iguais em toda instalação, e não servem para nada fora da sua máquina.
#
# Onde cada variável mora em produção:
#   API (FastAPI)  -> VPS, em /opt/cauri/.env (chmod 600)
#   Jobs           -> GitHub Actions, em secrets do repositório
#   Front          -> Cloudflare Pages, só as VITE_* (públicas por design)

# ---------------------------------------------------------------------------------
# API (VPS: /opt/cauri/.env)
# ---------------------------------------------------------------------------------

# Conexão com o Postgres como role cauri_api (nunca o dono do banco).
# Em produção: pooler do Supabase (Supavisor), que aceita IPv4.
CAURI_DATABASE_URL=postgresql://cauri_api:cauri_api_local@127.0.0.1:54322/postgres

# URL do projeto Supabase. A API busca as chaves públicas do JWT no JWKS dele.
# Em produção: https://<projeto>.supabase.co
CAURI_SUPABASE_URL=http://127.0.0.1:54321

# Segredo HS256 do JWT. Só para o Supabase local ou projeto com chave legada.
# Em produção, com chaves assimétricas, deixe vazio.
CAURI_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Origens liberadas no CORS (lista JSON). Em produção: o domínio do Pages.
CAURI_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Tamanho máximo do pool de conexões da API.
CAURI_DB_POOL_MAX=5

# Interpretação de texto do assistente (Fase 5): Haiku com saída estruturada. VPS.
ANTHROPIC_API_KEY=
CAURI_ANTHROPIC_MODEL=claude-haiku-5-5
# "anthropic" em produção. "regras" só em desenvolvimento e nos testes ao vivo sem chave:
# entende frases simples, sem IA.
CAURI_ASSISTANT_EXTRACTOR=anthropic

# Transcrição de voz via Whisper no Groq (Fase 5). VPS. Sem chave, o front usa a
# Web Speech API do navegador.
GROQ_API_KEY=

# ---------------------------------------------------------------------------------
# Jobs (GitHub Actions secrets; localmente, este .env)
# ---------------------------------------------------------------------------------

# Conexão como role cauri_ingest: escreve mercado e snapshots, nunca o ledger.
CAURI_INGEST_DATABASE_URL=postgresql://cauri_ingest:cauri_ingest_local@127.0.0.1:54322/postgres

# Conexão como dono do banco. Só para seed do demo e bootstrap do admin; nunca na API.
# Em produção fica só no GitHub (workflow manual) ou na sua máquina, nunca na VPS.
CAURI_ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# E-mail do admin inicial, usado pelo `cauri-jobs bootstrap-admin`.
# Fica só no ambiente: nenhum e-mail pessoal vai para o código.
CAURI_ADMIN_EMAIL=admin@example.test

# Pasta de cache dos arquivos baixados (COTAHIST, CSV do Tesouro).
CAURI_CACHE_DIR=.cache/market

# Token do brapi.dev (fechamento diário de ações e FIIs). GitHub secret.
BRAPI_API_KEY=

# Cota mensal de chamadas da brapi (plano gratuito: 15000). O job para antes de estourar.
CAURI_BRAPI_MONTHLY_QUOTA=15000

# Chave do CoinGecko Demo (cripto em BRL e USD). GitHub secret.
COINGECKO_API_KEY=

# ---------------------------------------------------------------------------------
# Front (Cloudflare Pages, Fase 3). Públicas por design: quem protege é o RLS.
# ---------------------------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Chave publishable do Supabase local (a mesma em toda instalação da CLI; `supabase status`).
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
VITE_API_URL=http://127.0.0.1:8000
